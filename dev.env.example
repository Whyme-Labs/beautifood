# Local development settings. `pnpm dev` copies this to .env (gitignored) if it is missing.
APP_ENV=development
PUBLIC_URL=http://localhost:5173
# Optional: Claude for the menu assistant, onboarding and insights (a local engine answers without it)
# ANTHROPIC_API_KEY=
# Optional: Web Push (generate with: node scripts/vapid-keys.mjs)
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# Optional: storefronts on subdomains, e.g. http://<slug>.localhost:5173 serves that restaurant's page
# STOREFRONT_DOMAIN=localhost
