{
  "name": "beautifood",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.21.0"
  },
  "scripts": {
    "core": "./scripts/build-core.sh",
    "dev": "vite",
    "build": "vite build",
    "typecheck": "void prepare && tsc --noEmit",
    "test": "pnpm test:rust && pnpm test:unit",
    "test:rust": "cargo test --manifest-path crates/core/Cargo.toml",
    "test:unit": "vitest run",
    "test:e2e": "playwright test"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "workerd",
      "sharp"
    ]
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.135.0",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@void/react": "1.1.11",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5",
    "void": "1.1.11"
  }
}
